# --- Base de datos (Supabase / PostgreSQL) ---
# App (pooler en modo transacción, puerto 6543) — requiere ?pgbouncer=true para Prisma
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migraciones (pooler en modo sesión, puerto 5432)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Object Storage (AWS S3 en prod / MinIO en dev local) ---
# storage.ts usa forcePathStyle: true, así que ENDPOINT y PUBLIC_URL son el endpoint
# regional; el código agrega /${STORAGE_BUCKET}/${key} automáticamente.
STORAGE_ACCESS_KEY=AKIA...
STORAGE_SECRET_KEY=...
STORAGE_ENDPOINT=https://s3.us-east-2.amazonaws.com
STORAGE_PUBLIC_URL=https://s3.us-east-2.amazonaws.com
STORAGE_REGION=us-east-2
STORAGE_BUCKET=biomaternal-prod

# Dev local con MinIO (docker-compose):
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_PUBLIC_URL=http://localhost:9000
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin
# STORAGE_BUCKET=biomaternal-media
# STORAGE_REGION=us-east-1
