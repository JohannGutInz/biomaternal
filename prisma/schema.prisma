generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
  SPECIALIST
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  username       String
  hashedPassword String   @map("hashed_password")
  role           UserRole @default(STAFF)
  createdAt      DateTime @default(now()) @map("created_at")

  specialist Specialist?

  @@map("users")
}

model Specialty {
  id      String  @id @default(uuid())
  name    String  @unique
  enabled Boolean @default(true)

  specialists Specialist[]

  @@map("specialties")
}

enum Genre {
  MALE
  FEMALE
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  REQUIRES_CHANGES
}

model Kyc {
  id           String    @id @default(uuid())
  status       KycStatus @default(PENDING)
  comment      String?
  internalNote String?   @map("internal_note")
  rejectedAt   DateTime? @map("rejected_at")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  specialist Specialist?
  reviewLogs KycReviewLog[]

  @@map("kycs")
}

// One row per moderateKycAction call — Kyc only ever holds the latest
// decision/comment, so this is the only place a past review (and whether it
// had a comment at all) survives the next one.
model KycReviewLog {
  id         String    @id @default(uuid())
  kycId      String    @map("kyc_id")
  kyc        Kyc       @relation(fields: [kycId], references: [id], onDelete: Cascade)
  decision   KycStatus
  comment    String?
  reviewedBy String?   @map("reviewed_by")
  reviewedAt DateTime  @default(now()) @map("reviewed_at")

  @@index([kycId])
  @@map("kyc_review_logs")
}

// Especialista médico — evolución de Model (talento de agencia). Sin
// atributos de talento (tallas, tatuajes, pasaporte) ni geografía relacional
// (Country/State/Municipality); `location` es texto libre, igual que
// Sucursal.address.
model Specialist {
  id               String   @id @default(uuid())
  firstName        String   @map("first_name")
  paternalLastName String   @map("paternal_last_name")
  maternalLastName String?  @map("maternal_last_name")
  email            String   @unique
  phone            String
  birthDate        DateTime @map("birth_date") @db.Date
  genre            Genre
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  licenseNumber String? @map("license_number")
  bio           String?
  location      String?
  photoUrl      String? @map("photo_url")
  isPublic      Boolean @default(false) @map("is_public")
  internalNotes String? @map("internal_notes")

  kycId String @unique @map("kyc_id")
  kyc   Kyc    @relation(fields: [kycId], references: [id])

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  specialties Specialty[]

  reservations Reservation[]

  @@map("specialists")
}

model Sucursal {
  id        String   @id @default(uuid())
  name      String
  address   String
  phone     String?
  timezone  String   @default("America/Mazatlan")
  openTime  String   @map("open_time")
  closeTime String   @map("close_time")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  consultorios Consultorio[]

  @@map("sucursales")
}

model Consultorio {
  id          String   @id @default(uuid())
  name        String
  floor       String?
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  hourlyRate  Int?     @map("hourly_rate")
  dayRate     Int?     @map("day_rate")
  createdAt   DateTime @default(now()) @map("created_at")

  sucursalId String   @map("sucursal_id")
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  fotos        ConsultorioFoto[]
  reservations Reservation[]

  @@map("consultorios")
}

model ConsultorioFoto {
  id        String   @id @default(uuid())
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  consultorioId String      @map("consultorio_id")
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)

  @@unique([consultorioId, position])
  @@map("consultorio_fotos")
}

enum ReservationType {
  FULL_DAY
  HOURLY
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// Integridad de no-solape: constraint EXCLUDE USING gist a nivel BD (ver
// migration.sql — Prisma no tiene atributo declarativo para esto) + chequeo
// transaccional en el servicio (src/lib/actions.ts). Ninguno de los dos basta
// solo: la UI no es la fuente de verdad.
model Reservation {
  id     String @id @default(uuid())
  startAt DateTime @map("start_at")
  endAt   DateTime @map("end_at")

  type         ReservationType
  status       ReservationStatus @default(PENDING)
  priceApplied Int?              @map("price_applied")
  notes        String?
  createdBy    String?           @map("created_by")
  createdAt    DateTime          @default(now()) @map("created_at")

  consultorioId String      @map("consultorio_id")
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])

  specialistId String     @map("specialist_id")
  specialist   Specialist @relation(fields: [specialistId], references: [id])

  charge Charge?

  @@index([consultorioId])
  @@index([specialistId])
  @@map("reservations")
}

enum ChargeStatus {
  PENDING
  PAID
  WAIVED
}

enum ChargeMethod {
  CASH
  TRANSFER
  CARD
}

model Charge {
  id       String       @id @default(uuid())
  amount   Int
  currency String       @default("MXN")
  method   ChargeMethod
  status   ChargeStatus @default(PENDING)
  paidAt   DateTime?    @map("paid_at")
  createdBy String?     @map("created_by")
  createdAt DateTime    @default(now()) @map("created_at")

  reservationId String      @unique @map("reservation_id")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("charges")
}
