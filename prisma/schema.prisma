generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
  MODEL
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  username       String
  hashedPassword String   @map("hashed_password")
  role           UserRole @default(USER)
  createdAt      DateTime @default(now()) @map("created_at")

  model Model?

  @@map("users")
}

model Country {
  id      String @id @default(uuid())
  name    String
  label   String @unique // MX, USA, etc
  demonym String // Mexicano, American, etc

  models                Model[] @relation("ModelResidenceCountry")
  modelsWithNationality Model[] @relation("ModelNationality")
  states                State[]

  @@map("countries")
}

model State {
  id    String @id @default(uuid())
  name  String
  label String @unique

  cities Municipality[]

  countryId String  @map("country_id")
  country   Country @relation(fields: [countryId], references: [id])

  @@map("states")
}

model Municipality {
  id    String @id @default(uuid())
  name  String
  label String @unique // CLN,

  stateId String @map("state_id")
  state   State  @relation(fields: [stateId], references: [id])

  models Model[]

  @@map("municipalities")
}

model Category {
  id      String  @id @default(uuid())
  name    String  @unique
  enabled Boolean @default(true)

  models Model[]

  @@map("categories")
}

model Activity {
  id      String  @id @default(uuid())
  name    String
  enabled Boolean @default(true)

  models Model[]

  @@map("activities")
}

enum ModelGenre {
  MALE
  FEMALE
}

enum ShirtSize {
  XS
  S
  M
  L
  XL
  XXL
}

enum PantsSizeScale {
  MEN
  WOMEN
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  REQUIRES_CHANGES
}

enum PackageStatus {
  DRAFT
  SENT
  CLOSED
}

enum ConvocatoriaStatus {
  DRAFT
  OPEN
  CLOSED
}

enum MediaType {
  PHOTO_CASUAL
  PHOTO_BOOK
  PHOTO_EVENT
  VIDEO_LINK
}

model Kyc {
  id           String    @id @default(uuid())
  status       KycStatus @default(PENDING)
  comment      String?
  internalNote String?   @map("internal_note")
  rejectedAt   DateTime? @map("rejected_at")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  model      Model?
  reviewLogs KycReviewLog[]

  @@map("kycs")
}

// One row per moderateKycAction call — Kyc only ever holds the latest
// decision/comment, so this is the only place a past review (and whether it
// had a comment at all) survives the next one.
model KycReviewLog {
  id         String    @id @default(uuid())
  kycId      String    @map("kyc_id")
  kyc        Kyc       @relation(fields: [kycId], references: [id], onDelete: Cascade)
  decision   KycStatus
  comment    String?
  reviewedBy String?   @map("reviewed_by")
  reviewedAt DateTime  @default(now()) @map("reviewed_at")

  @@index([kycId])
  @@map("kyc_review_logs")
}

model Model {
  id               String     @id @default(uuid())
  firstName        String     @map("first_name")
  paternalLastName String     @map("paternal_last_name")
  maternalLastName String?    @map("maternal_last_name")
  email            String     @unique
  phone            String
  birthDate        DateTime   @map("birth_date") @db.Date
  genre            ModelGenre
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at")

  height             Int?            @map("height_cm")
  currentWeight      Int?            @map("current_weight_kg")
  hasVisibleTattoos  Boolean         @default(false) @map("has_visible_tattoos")
  shirtSize          ShirtSize?      @map("shirt_size")
  pantsSizeScale     PantsSizeScale? @map("pants_size_scale")
  pantsSize          String?         @map("pants_size")
  travelAvailability Boolean         @default(false) @map("travel_availability")
  hasPassport        Boolean         @default(false) @map("has_passport")
  hasVisa            Boolean         @default(false) @map("has_visa")
  hiddenFromCatalog  Boolean         @default(false) @map("hidden_from_catalog")

  assets             Asset[]
  media              ModelMedia[]
  convocatoriaVistas ConvocatoriaVista[]
  packages           Package[]

  kycId String @unique @map("kyc_id")
  kyc   Kyc    @relation(fields: [kycId], references: [id])

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  categories Category[]
  activities Activity[]

  countryId String  @map("country_id")
  country   Country @relation("ModelResidenceCountry", fields: [countryId], references: [id])

  nationalityId String  @map("nationality_id")
  nationality   Country @relation("ModelNationality", fields: [nationalityId], references: [id])

  cityId String       @map("city_id")
  city   Municipality @relation(fields: [cityId], references: [id])

  @@map("models")
}

enum AssetType {
  MAIN_PHOTO
  PHOTO
  VIDEO
}

model Asset {
  id        String    @id @default(uuid())
  type      AssetType
  url       String
  position  Int
  createdAt DateTime  @default(now()) @map("created_at")

  modelId String @map("model_id")
  model   Model  @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, type, position])
  @@map("assets")
}

model ModelMedia {
  id        String    @id @default(uuid())
  url       String
  type      MediaType
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  modelId String @map("model_id")
  model   Model  @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, type, position])
  @@map("model_media")
}

model Convocatoria {
  id             String             @id @default(uuid())
  titulo         String
  ciudad         String
  tipo           String
  fechaEvento    DateTime           @map("fecha_evento") @db.Date
  horario        String
  lugar          String
  funciones      String
  pago           String
  perfil         String
  cuerpo         String             @default("")
  whatsappNumber String             @map("whatsapp_number")
  status         ConvocatoriaStatus @default(DRAFT)
  publishedAt    DateTime?          @map("published_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  vistas ConvocatoriaVista[]

  @@map("convocatorias")
}

model Package {
  id          String        @id @default(uuid())
  name        String
  description String?
  token       String        @unique @default(uuid())
  status      PackageStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  models Model[]

  @@map("packages")
}

model ConvocatoriaVista {
  id             String   @id @default(uuid())
  modeloId       String   @map("modelo_id")
  convocatoriaId String   @map("convocatoria_id")
  vistoAt        DateTime @default(now()) @map("visto_at")

  modelo       Model        @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  convocatoria Convocatoria @relation(fields: [convocatoriaId], references: [id], onDelete: Cascade)

  @@unique([modeloId, convocatoriaId])
  @@map("convocatoria_vistas")
}

// Agency marketing photos shown in the public landing carousel (EventosCarrusel).
// Not to be confused with ModelMedia.PHOTO_EVENT, which is a model's own event
// photos inside their personal book.
model EventoFoto {
  id        String   @id @default(uuid())
  url       String
  alt       String
  position  Int      @default(0)
  // Matches the app-level rule: crearEventoFotoAction (actions.ts) always
  // creates rows unpublished — the admin publishes by hand after review.
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("evento_fotos")
}
